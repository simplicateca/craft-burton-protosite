{% extends "_burton/base/partial" -%}

{## Render Block
{-------------------------------------------------------------------------------------##}
{% block output -%}
    {%- set block = block ?? null -%}
    {%- set settings = settings ?? {} -%}
    {%- set loops = loops ?? {} -%}

    {%- set settings = settings | merge({
        zonelayout: ( loops.block.index ?? 1 % 2 )
            ? settings.zonereverse ?? settings.zonelayout ?? null
            : settings.zonelayout ?? null,
        zonereverse: null
    }, true ) -%}

    {%- if settings.zonesuffix ?? 'none' != 'none' -%}
        {%- set settings = settings | merge({
            zonelayout: ["#{settings.zonelayout}-#{settings.zonesuffix}", settings.zonelayout ]
        }, true ) -%}
    {%- endif -%}

    {%- set blockContent = block('blockContent', _path ?? _self) | trim -%}

    {%- if blockContent is not empty -%}
        {%- if loops.block.index ?? null > 1 -%}
            {{- block( 'beforeContent', _path ?? _self ) -}}
        {%- endif -%}

        {%- set blockContent = _self.tagOrRaw( blockContent, tag ?? null, {
            data: { monitor: true },
            class: ["w-full relative z-20 @container"],
            'x-data': "{ open: false }",
        }) -%}

        {%- if settings.containersuffix ?? 'none' != 'none' -%}
            {%- set settings = settings | merge({
                container: ["#{settings.container}-#{settings.containersuffix}", settings.container ]
            }, true ) -%}
        {%- endif -%}

        {%- import "_burton" as b -%}
        {{- b.container( blockContent, settings.container ?? 'none' ) -}}
    {%- endif -%}
{%- endblock -%}


{%- block beforeContent -%}
    {%- import "_burton" as b -%}
    {{- b.sep( block, settings.spacer ?? 'medium' ) -}}
{%- endblock -%}


{%- block blockContent -%}
    {%- if block.html ??? null -%}
        {{- raw( block.html ) -}}
    {%- else -%}
        {%- import "_burton" as b -%}
        {{- b.zonelayout({
            zone1 : block('zone1', _path ?? _self),
            zone2 : block('zone2', _path ?? _self),
            header: block('header', _path ?? _self),
            footer: block('footer', _path ?? _self)
        }, ...settings ) -}}
    {%- endif -%}
{%- endblock -%}


{## [Zone Content] Block Intro
{-------------------------------------------------------------------------------------##}
{% block header -%}
    {%- import "_burton" as b -%}
    {{- b.text( TextBase( block.intro ?? block.introHeader ?? "" ).body,
        "blockH1" ) -}}
{% endblock %}


{## [Zone Content] Block Outro
{-------------------------------------------------------------------------------------##}
{%- block footer -%}
    {{- TextBase( block.text ?? block.textHeader ?? "" ).body
        | retconOnly( ['.outro'] ) -}}
{%- endblock -%}


{## [Zone Content] Zone 1
{-------------------------------------------------------------------------------------##}
{% block zone1 -%}
    {{- TextBase( block.text ?? block.textHeader ?? "" ).body
        | retconRemove( ['.outro'] ) -}}

    {%- if 'interactive' == settings.format ?? null -%}
        <p>
            <button x-on:click="open = !open" class="button">See More</button>
        </p>
    {%- endif -%}
{%- endblock %}


{## [Zone Content] Zone 2
{-------------------------------------------------------------------------------------##}
{%- block zone2 -%}
    {%- set zone2Type = block.type.handle ?? block.type ?? null -%}
    {{ zone2Type in ["bits", "component", "deck", "image", "media", "text", "fragment"]
        ? block("block__#{zone2Type}", _path ?? _self)
        : block("block__unknown", _path ?? _self) -}}
{%- endblock -%}


{## [Block Type] Bits
{-------------------------------------------------------------------------------------##}
{%- block block__bits -%}
    {%- set limit = settings.limit ?? 100 -%}
    {%- set limit = limit == 0 ? -1 : limit -%}
    {%- set bits = [] -%}

    {% switch block.source ?? null %}
        {% case "collection" %}
            {%- set select = settings.filter ?? request.getParam('f') ?? null -%}
            {%- set avail  = collect( block.collection ?? settings.collection ?? [] ) -%}
            {%- set bits   = collection( avail.firstWhere( 'slug', select ) ?? avail.first() ) -%}

            {%- if settings.topicFilter ?? null -%}
                {%- set newbits = bits.filter( b => b.topics.ids()|intersect(settings.topicFilter)|length ) -%}
                {%- set bits = collect( newbits.values() ).all() -%}
            {%- endif -%}
        {% default %}
            {%- set bits = collect( block.bits ?? settings.bits ?? [] ) -%}
            {%- set bits = craft.entries()
                .id( bits | map( e => e.id ) | filter( id => id is not empty ) )
                .fixedOrder( settings.orderBy ?? null is empty ) -%}
    {% endswitch %}

    {%- if bits ?? null is object and className(bits) != 'Illuminate\\Support\\Collection' -%}
        {%- if settings.topicFilter ?? null is not empty  -%}
            {%- set f = craft.app.request.getQueryParam('f') ?? null -%}
            {%- set bits = f ? bits.relatedTo(f) : bits -%}
        {%- endif -%}

        {%- if settings.orderBy ?? null is not empty -%}
            {%- set bits = bits.orderBy(settings.orderBy) -%}
        {%- endif -%}

        {%- if limit > 0 -%}
            {%- set bits = bits.limit(limit) -%}
        {%- endif -%}

        {%- set bits = collect( bits ).all() -%}
    {%- endif -%}

    {%- block bits__layout -%}
        {%- import "_burton" as b -%}
        {%- set bits = bits ?? [] -%}
        {%- set settings = settings ?? {} -%}
        {{- b.layout( bits, ...settings ) -}}
    {%- endblock -%}
{%- endblock -%}


{## [Block Type] Component
{-------------------------------------------------------------------------------------##}
{%- block block__component -%}
    {{- renderMacroIfExists(
        _path ?? ["_burton/local/block", "_burton/theme/block", "_burton/base/block"],
        ["component__#{block.source}", "component__#{block.component.type ??? null}" ],
        block ?? null,
        settings ?? {}
    ) | raw -}}
{%- endblock -%}


{## [Block Type] Deck
{-------------------------------------------------------------------------------------##}
{%- block block__deck -%}

    {%- set params = ( settings.queryParams ?? craft.app.request.getQueryParams() ) | filter -%}
    {% switch block.source ?? null %}
        {% case "collection" %}
            {%- set collections = block.collections ?? settings.collections ?? [] -%}
            {%- if collections is string or collections is numeric -%}
                {%- set sources = craft.entries().section("collections") -%}
                {%- set source = collections is numeric ? sources.id([collections|trim]).one() : sources.slug(collections).one() -%}
            {%- endif -%}

            {%- if collections is array and collections|join is numeric -%}
                {%- set source = craft.entries().id(params.c ?? null in sources ? params.c : sources|first).one() -%}
            {%- endif -%}

            {%- if collections is array and collections|join is string -%}
                {%- set sources = craft.entries().section("collections").slug(sources) -%}
                {%- set source = params.c ?? null is numeric ? sources.id(params.c).one() : sources.one() -%}
            {%- endif -%}

            {%- if collections is array and collections[0] ?? null is object and className(sources[0]) == "craft\\elements\\Entry" -%}
                {%- set sources = collect(sources).where("section.handle", "collections") -%}
                {%- set source = params.c ?? null is numeric ? sources.firstWhere('id', params.c) : sources.first() -%}
            {%- endif -%}

            {% if collections is object and className(collections) == "craft\\elements\\db\\EntryQuery" -%}
                {%- set source = params.c ?? null is numeric ? collections.id(params.c).one() : collections.one() -%}
            {%- endif -%}

            {%- set entries = ( source.type.handle ?? null == 'collectionEntries' )
                ? source.entries ?? []
                : collection(source) -%}
        {% default %}
            {%- set entries = block.entries ?? settings.entries ?? [] -%}
    {% endswitch %}

    {%- set limit = settings.limit ?? 100 -%}
    {%- set orderBy = settings.orderBy ?? source.query.orderBy ?? null -%}

    {%- if (params.q ?? params.f ?? params.t ?? null) is not empty and entries is array -%}
        {%- set refind = entries|map(e => e.id)|filter(id => id ?? null )|filter|values -%}
        {%- set entries = refind|join is numeric ? craft.entries().id(refind).fixedOrder(true) : null -%}
    {%- endif -%}

    {%- if entries is object and className(entries) == "craft\\elements\\db\\EntryQuery" -%}
        {%- if setting.textFilter ?? null is string -%}
            {%- set entries = entries.search(setting.textFilter) -%}{%- endif -%}
        {%- if params.q ?? null is string -%}
            {%- set entries = entries.search(params.q) -%}{%- endif -%}
        {%- if params.f ?? null is string -%}
            {%- set entries = entries.customFilter1(params.f) -%}{%- endif -%}
        {%- if params.t ?? null is numeric -%}
            {%- set entries = entries.relatedTo({ targetElement: params.t, field: 'details.topics' }) -%}{%- endif -%}
        {%- if orderBy is not null -%}
            {%- set entries = entries.orderBy( orderBy is array ? orderBy|join(' ') : orderBy ) -%}{%- endif -%}
        {%- if limit > 0 -%}
            {%- set entries = entries.limit(limit) -%}
            {%- paginate entries as pageinfo, entries -%}
            {%- set settings = settings | merge({ pageinfo }) -%}{%- endif -%}
    {%- endif -%}

    {%- block deck__layout -%}
        {%- import "_burton" as b -%}
        {%- set entries  = entries  ?? [] -%}
        {%- set settings = settings ?? {} -%}
        {{- b.layout( entries, ...settings ) -}}
    {%- endblock -%}

    {# {%- if entries is empty -%}
        <h1>No Entries Found</h1>

    {# {%- else -%}
        {%- if entries is array -%}
            {%- set entries = collect(entries) -%}{%- endif -%}
        {%- endif -%}
        {%- if entries is object and className(entries) == "Illuminate\\Support\\Collection" -%}{%- endif -%}
        {%- if settings.orderBy ?? null and entries is object and className(entries) == "Illuminate\\Support\\Collection" -%}
            {%- set entries = entries.sortBy(settings.orderBy) -%}{%- endif -%}
        {%- if entries is array and entries|length > limit -%}
            {%- set entries = entries|slice(0, limit) -%}{%- endif -%}
        {%- if entries is object and className(entries) == "Illuminate\\Support\\Collection" -%}
            {%- set entries = entries.count() > limit ? entries.slice(limit).all() : entries.all() -%}{%- endif -%}
    {%- endif -%} #}

{%- endblock -%}



{## [Block Type] Image
{-------------------------------------------------------------------------------------##}
{%- block block__image -%}
    {%- set limit = settings.limit ?? 100 -%}
    {%- set limit = limit > 0 ? limit : 1 -%}

    {% switch block.source ?? null %}
        {% case "collection" %}
            {%- set select = settings.filter ?? request.getParam('f') ?? null -%}
            {%- set avail  = collect( block.collections ?? settings.collections ?? [] ) -%}
            {%- set images = collection( avail.firstWhere( 'slug', select ) ?? avail.first() ) -%}
        {% default %}
            {%- set images = collect( block.images ?? block.image ?? settings.images ?? settings.image ).slice(0, limit).all() -%}
    {% endswitch %}

    {## Look for Auto-Linking
    {---------------------------------------------------------------------------------##}
    {%- set autolink = _self.autolink_extractor( block('zone1', _path ?? _self), 'only' ) -%}
    {%- if autolink is not empty -%}
        {%- set settings = settings | merge({ href: autolink }) -%}
    {%- endif -%}

    {## Render Images
    {---------------------------------------------------------------------------------##}
    {%- import "_burton" as b -%}
    {%- set images = images | map( m => b.image( m, ...settings ) ) -%}

    {%- block image__layout -%}
        {%- import "_burton" as b -%}
        {%- set images = images ?? {} -%}
        {%- set settings = settings ?? {} -%}
        {{- b.layout( images, ...settings ) -}}
    {%- endblock -%}
{%- endblock -%}


{## [Block Type] Media
{-------------------------------------------------------------------------------------##}
{%- block block__media -%}
    {%- set limit  = settings.limit ?? 100 -%}
    {%- set limit  = limit > 0 ? limit : 1 -%}

    {% switch block.source ?? null %}
        {% case "embed" %}
            {%- set medias = collect( block.embeds ?? settings.embeds ).slice(0, limit).all() -%}
        {% case "collection" %}
            {%- set select = settings.filter ?? request.getParam('f') ?? null -%}
            {%- set avail  = collect( block.collections ?? settings.collections ?? [] ) -%}
            {%- set medias = collection( avail.firstWhere( 'slug', select ) ?? avail.first() ) -%}
        {% default %}
            {%- set medias = collect( block.medias ?? settings.medias ).slice(0, limit).all() -%}
    {% endswitch %}

    {%- set medias = medias | map( m => b.media( m, ...settings ) ) -%}

    {%- block media__layout -%}
        {%- import "_burton" as b -%}
        {%- set medias = medias ?? {} -%}
        {%- set settings = settings ?? {} -%}
        {{- b.layout( medias, ...settings ) -}}
    {%- endblock -%}
{%- endblock -%}



{## [Block Type] Text
{-------------------------------------------------------------------------------------##}
{%- block block__text -%}
    {%- block text__layout -%}
        {{- settings.secondary ?? null != 'copyNone'
            ? raw( TextBase( block.text2 ?? "" ).body ?? "" ) -}}
    {%- endblock -%}
{%- endblock -%}


{## [Block Type] Fragment
{-------------------------------------------------------------------------------------##}
{%- block block__fragment -%}

    {%- import "_burton" as b -%}
    {%- set fragments = collect( block.fragments ?? [] ) -%}
    {%- set builders = fragments.map( f => b.builder( f.builder ?? [], 'fragment' ) ) -%}

    {%- block fragment__layout -%}
        {%- if 'interactive' == settings.format ?? null -%}
            <div x-cloak x-show="open" x-transition class="relative @container">
                {{- builders|join()
                    | retconChange( 'section[data-theme]', false )
                    | retconChange( '[data-container]', false ) -}}
            </div>

            {## Interactive Modal Version
            {-------------------------------------------------------------------------------##}
            {# {%- set content = tag('div') -%}
            {%- for fragment in block.fragments.all() -%}
                {%- set content = content | append( b.builder( fragment.builder.all() ?? [], 'fragment' ) ) -%}
            {%- endfor -%}

            {{- include( ["_burton/local/modal", "_burton/theme/modal", "_burton/base/modal"], {
                content: raw( content )
            }, withContext = false ) -}} #}
        {%- endif -%}
    {%- endblock -%}
{%- endblock -%}


{## [Block Type] Unknown
{-------------------------------------------------------------------------------------##}
{%- block block__unknown -%}
    <h1>Unknown Block</h1>
{%- endblock -%}


{## Component Macros
{-------------------------------------------------------------------------------------##}
{%- macro component__form( block ) -%}
    {%- set form = craft.formie.forms({ handle: block.component.handle }).one() %}
    {%- if form -%}
        {% do craft.formie.populateFormValues( form, { parentEntry: block.primaryOwnerId ?? null } ) %}
        {{- craft.formie.renderForm( form, { themeConfig: varargs.themeConfig } ) -}}
    {%- endif -%}
{%- endmacro -%}


{%- macro component__embed( block ) -%}
    {{- block.code | raw -}}
{%- endmacro -%}


{%- macro component__menu( block ) -%}
    {%- import "_burton" as b -%}
    {{- b.menu( block.component.handle, ...varargs ) -}}
{%- endmacro -%}



{%- macro autolink_extractor( input_html, type ) -%}
    {%- set type  = type ?? 'only' -%}
    {%- set links = input_html | retconOnly("a[href]") -%}
    {%- set links = links|split('</a>') -%}
    {%- set hrefs = [] -%}

    {%- for x in links -%}
        {%- set attrs = x|parseAttr -%}
        {%- if attrs.href is defined -%}
            {%- set hrefs = hrefs|merge([attrs.href]) -%}
        {%- endif -%}
    {%- endfor -%}

    {%- set hrefs = hrefs|filter(v => v is not empty) -%}

    {%- if hrefs[0] ?? null and type == 'first' -%}
        {{- hrefs|first|raw -}}
    {%- endif -%}

    {%- if hrefs[0] ?? null and type == 'last' -%}
        {{- hrefs|last|raw -}}
    {%- endif -%}

    {%- if hrefs[0] ?? null and type == 'only' and hrefs|length == 1 -%}
        {{- hrefs|first|raw -}}
    {%- endif -%}
{%- endmacro -%}
